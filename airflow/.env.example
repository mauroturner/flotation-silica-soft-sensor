# The secrets of docker-compose.yaml. Copy this file to .env (git-ignored) and fill each value; the compose file has no default for any of them
# and refuses to start while one is missing or empty. Never commit .env. Generate each value on your own machine:
#
#   FLOTSILICA_DB_PASSWORD      python -c "import secrets; print(secrets.token_hex(24))"          (the metadata database's password: PostgreSQL and every connection string)
#   FLOTSILICA_FERNET_KEY       python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   FLOTSILICA_JWT_SECRET       python -c "import secrets; print(secrets.token_urlsafe(48))"
#   FLOTSILICA_ADMIN_PASSWORD   python -c "import secrets; print(secrets.token_urlsafe(16))"      (the password of the Airflow user)
#
# Optional, not secrets: AIRFLOW_UID (on Linux, the output of `id -u`), FLOTSILICA_CONFIG (the pipeline configuration inside the container).
FLOTSILICA_DB_PASSWORD=
FLOTSILICA_FERNET_KEY=
FLOTSILICA_JWT_SECRET=
FLOTSILICA_ADMIN_PASSWORD=
